resource "aws_ecr_repository" "gateway" {
  name = local.name

  # A tag (the commit SHA) always means the same image.
  image_tag_mutability = "IMMUTABLE"

  # Lets "terraform destroy" remove the repository even if it still has images.
  force_delete = true

  image_scanning_configuration {
    scan_on_push = true # basic scanning, no charge
  }

  encryption_configuration {
    encryption_type = "AES256"
  }
}

resource "aws_ecr_lifecycle_policy" "gateway" {
  repository = aws_ecr_repository.gateway.name

  policy = jsonencode({
    rules = [
      {
        rulePriority = 1
        description  = "Drop untagged images after a day"
        selection = {
          tagStatus   = "untagged"
          countType   = "sinceImagePushed"
          countUnit   = "days"
          countNumber = 1
        }
        action = { type = "expire" }
      },
      {
        rulePriority = 2
        description  = "Keep only the five most recent images"
        selection = {
          tagStatus   = "any"
          countType   = "imageCountMoreThan"
          countNumber = 5
        }
        action = { type = "expire" }
      },
    ]
  })
}
