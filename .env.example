OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Leave empty to run without a cache.
REDIS_URL=redis://localhost:6379/0

# How long cached responses live, in seconds.
CACHE_TTL_SECONDS=3600

# Postgres holds users, API keys and usage. Docker Compose sets its own value.
DATABASE_URL=postgresql://gateway:local_dev_only@localhost:5432/gateway

# Maximum Postgres connections per gateway instance.
DB_POOL_MAX=10

RATE_LIMIT_FAIL_OPEN=true